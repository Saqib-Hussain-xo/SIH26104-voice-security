# Environment template for SIH26104 Voice Security Platform

# Runtime & Server
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Security & CORS (comma separated origins for production, e.g. https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Audio Validation Limits
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SEC=30
MIN_AUDIO_DURATION_SEC=0.5
TARGET_SAMPLE_RATE=16000

# Persistence & Storage
DATABASE_PATH=backend/data/analysis.db
TEMP_DIR=backend/temp
ENROLLMENT_DIR=backend/data/enrollments
PRETRAINED_MODELS_DIR=backend/pretrained_models

# Frontend API URL (for Vite deployment)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
